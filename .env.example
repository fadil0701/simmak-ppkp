APP_NAME="SIMMAK PPKP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─────────────────────────────────────────────
# DEVELOPMENT: MySQL lokal (Laragon)
# ─────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simmak_ppkp
DB_USERNAME=root
DB_PASSWORD=

# ─────────────────────────────────────────────
# PRODUCTION: PostgreSQL 17 (VM/Docker)
# Uncomment dan sesuaikan saat deploy:
# ─────────────────────────────────────────────
# DB_CONNECTION=pgsql
# DB_HOST=<host-postgres-vm>
# DB_PORT=5432
# DB_DATABASE=simmak_ppkp
# DB_USERNAME=simmak
# DB_PASSWORD=<secret>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# LDAP Active Directory Pemprov DKI Jakarta
LDAP_ENABLED=false
LDAP_HOST=ldap.dki.go.id
LDAP_PORT=389
LDAP_BASE_DN="DC=dki,DC=go,DC=id"
LDAP_USERNAME=
LDAP_PASSWORD=
LDAP_USE_TLS=true

# Object Storage (Supabase / S3 compatible) — Production
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=simmak-ppkp
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@simmak.ppkp.local"
MAIL_FROM_NAME="${APP_NAME}"

# React Material Dashboard — API endpoint
VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=http://localhost:8000/api/v1
