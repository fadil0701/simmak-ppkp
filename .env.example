APP_NAME="SIMMAK PPKP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────
# DATABASE — satu berkas .env untuk semua lingkungan.
#
# Default di bawah = PostgreSQL 17 milik Docker Compose
# (port 5432 dipublikasikan ke host, jadi `php artisan` di
# Windows juga bisa langsung terhubung).
#
# Di dalam container, docker-compose.yml menimpa DB_HOST
# menjadi `postgres` lewat blok `environment:` — jadi tidak
# perlu file .env terpisah untuk Docker.
#
# Ingin pakai MySQL Laragon? cukup ubah 4 baris berikut:
#   DB_CONNECTION=mysql
#   DB_HOST=127.0.0.1
#   DB_PORT=3306
#   DB_USERNAME=root
#   DB_PASSWORD=
# ─────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=simmak_ppkp
DB_USERNAME=simmak
DB_PASSWORD=simmak_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# LDAP Active Directory Pemprov DKI Jakarta
LDAP_ENABLED=false
LDAP_HOST=ldap.dki.go.id
LDAP_PORT=389
LDAP_BASE_DN="DC=dki,DC=go,DC=id"
LDAP_USERNAME=
LDAP_PASSWORD=
LDAP_USE_TLS=true

# ClamAV Antivirus (scan bukti audit). Di Docker otomatis `clamav`.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Object Storage (Supabase / S3 compatible) — Production
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=simmak-ppkp
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@simmak.ppkp.local"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────
# KREDENSIAL AKUN — tidak ditulis di codebase, hanya di .env
#
# Akun super admin / administrator sistem dibuat lewat perintah:
#   php artisan simmak:create-superadmin
# (lihat juga: php artisan simmak:create-superadmin --help)
#
# Akun user lain (demo) dibuat oleh RoleUsersSeeder memakai
# DEFAULT_USER_PASSWORD di bawah.
# ─────────────────────────────────────────────────────────────

# Akun super admin / administrator sistem
SUPERADMIN_NAME="Administrator SIMMAK"
SUPERADMIN_USERNAME=admin
SUPERADMIN_EMAIL=admin@simmak.ppkp.local
SUPERADMIN_PASSWORD=

# Password default akun user selain super admin (RoleUsersSeeder).
# Jika kosong, seeder membuat password acak dan mencetaknya sekali di console.
DEFAULT_USER_PASSWORD=

# Fallback lama (opsional) — dipakai bila password di atas tidak diisi.
DEMO_ACCOUNT_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=http://localhost:8080/api/v1
