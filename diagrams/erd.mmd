    %% =========================================================================
    %% DOMAIN 1: CORE PLATFORM (14 tables) — #E3F2FD
    %% Multi-scope: organization_id | clinic_id | unit_id on transactional data
    %% =========================================================================

    ORGANIZATIONS {
        uuid id PK
        varchar code UK "ORG code"
        varchar name "PPKP DKI Jakarta"
        varchar org_type "central|clinic"
        text address
        varchar phone
        varchar email
        boolean is_active
        timestamptz created_at
        timestamptz updated_at
        uuid created_by FK
        uuid updated_by FK
    }

    CLINICS {
        uuid id PK
        uuid organization_id FK
        varchar code UK "Klinik code"
        varchar name
        varchar clinic_type "utama|pratama"
        boolean is_main_clinic
        varchar accreditation_status
        boolean is_active
        timestamptz created_at
        timestamptz updated_at
    }

    DEPARTMENTS {
        uuid id PK
        uuid organization_id FK
        uuid parent_id FK "self-ref hierarchy"
        varchar code UK
        varchar name
        varchar dept_type
        boolean is_active
    }

    UNITS {
        uuid id PK
        uuid clinic_id FK
        uuid department_id FK
        varchar code UK
        varchar name
        varchar unit_type "poli|lab|farmasi|etc"
        boolean is_active
    }

    EMPLOYEES {
        uuid id PK
        uuid organization_id FK
        uuid clinic_id FK
        uuid unit_id FK
        varchar nip UK
        varchar full_name
        varchar email
        varchar phone
        varchar position_title
        date hire_date
        boolean is_active
    }

    REFERENCE_DATA {
        uuid id PK
        uuid organization_id FK
        varchar category "finding_severity|risk_level|etc"
        varchar code UK
        varchar label
        jsonb metadata
        int sort_order
        boolean is_active
    }

    REFERENCE_DATA_VALUES {
        uuid id PK
        uuid reference_data_id FK
        varchar code
        varchar label
        varchar color_hex
        int sort_order
        boolean is_default
    }

    FISCAL_YEARS {
        uuid id PK
        uuid organization_id FK
        int year UK
        date start_date
        date end_date
        boolean is_current
        varchar status "open|closed"
    }

    SYSTEM_SETTINGS {
        uuid id PK
        varchar group "app|mail|storage|ldap"
        varchar key UK
        text value
        varchar value_type "string|int|bool|json"
        boolean is_encrypted
        text description
    }

    ORGANIZATION_SETTINGS {
        uuid id PK
        uuid organization_id FK
        varchar key
        text value
        varchar value_type
    }

    CLINIC_SETTINGS {
        uuid id PK
        uuid clinic_id FK
        varchar key
        text value
        varchar value_type
    }

    AUDIT_TRAILS {
        uuid id PK
        uuid user_id FK
        varchar auditable_type
        uuid auditable_id
        varchar event "created|updated|deleted|restored"
        jsonb old_values
        jsonb new_values
        varchar ip_address
        timestamptz created_at
    }

    ACTIVITY_LOGS {
        uuid id PK
        uuid user_id FK
        uuid clinic_id FK
        varchar log_name
        varchar subject_type
        uuid subject_id
        text description
        jsonb properties
        varchar ip_address
        timestamptz created_at
    }

    ATTACHMENTS {
        uuid id PK
        uuid organization_id FK
        varchar attachable_type "polymorphic"
        uuid attachable_id
        varchar file_name
        varchar storage_disk "supabase|local"
        varchar storage_path
        varchar mime_type
        bigint file_size
        uuid uploaded_by FK
        timestamptz created_at
    }

