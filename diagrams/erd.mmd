        timestamptz started_at
        timestamptz finished_at
    }

    LOGIN_ATTEMPTS {
        uuid id PK
        varchar email
        varchar ip_address
        varchar user_agent
        boolean successful
        varchar failure_reason
        timestamptz attempted_at
    }

    SESSIONS {
        uuid id PK
        uuid user_id FK
        varchar ip_address
        text user_agent
        text payload
        int last_activity
    }

    PERSONAL_ACCESS_TOKENS {
        uuid id PK
        uuid user_id FK
        varchar name
        varchar token UK
        text abilities
        timestamptz last_used_at
        timestamptz expires_at
    }

