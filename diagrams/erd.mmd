    USER_CLINIC_SCOPES {
        uuid id PK
        uuid user_id FK
        uuid clinic_id FK
        boolean is_default
        boolean can_view
        boolean can_edit
    }

    LDAP_CONFIGURATIONS {
        uuid id PK
