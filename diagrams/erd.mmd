    %% =========================================================================

    NOTIFICATION_CHANNELS {
        uuid id PK
        varchar code UK "in_app|email|sms"
        varchar name
        jsonb configuration
        boolean is_enabled
    }

    NOTIFICATION_TEMPLATES {
        uuid id PK
        uuid channel_id FK
        varchar event_type UK "document_expiry|capa_due|audit_scheduled"
        varchar subject_template
        text body_template
        jsonb variables_schema
        boolean is_active
    }

    NOTIFICATIONS {
        uuid id PK
        uuid organization_id FK
        uuid clinic_id FK
        varchar type
        varchar title
        text body
        jsonb data
        varchar priority "low|normal|high|urgent"
        timestamptz sent_at
        uuid triggered_by FK
    }

    NOTIFICATION_RECIPIENTS {
        uuid id PK
        uuid notification_id FK
        uuid user_id FK
        varchar delivery_status "pending|sent|delivered|failed"
        timestamptz read_at
        timestamptz delivered_at
    }

    NOTIFICATION_PREFERENCES {
        uuid id PK
        uuid user_id FK
        varchar event_type
        uuid channel_id FK
        boolean is_enabled
        varchar digest_frequency "instant|daily|weekly"
    }

    NOTIFICATION_LOGS {
        uuid id PK
        uuid notification_id FK
        uuid channel_id FK
        varchar status "queued|sent|failed|bounced"
        text error_message
        jsonb provider_response
        timestamptz attempted_at
    }

