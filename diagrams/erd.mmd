        uuid initiated_by FK
        timestamptz started_at
        timestamptz completed_at
    }

    WORKFLOW_INSTANCE_STEPS {
        uuid id PK
        uuid workflow_instance_id FK
        uuid workflow_step_id FK
        varchar status "pending|in_progress|completed|skipped"
        uuid assignee_id FK
        timestamptz started_at
        timestamptz completed_at
        int sla_breached_hours
    }

    WORKFLOW_ASSIGNMENTS {
        uuid id PK
        uuid instance_step_id FK
        uuid assignee_id FK
        uuid assigned_by FK
        timestamptz assigned_at
        timestamptz due_at
    }

    WORKFLOW_APPROVALS {
        uuid id PK
        uuid instance_step_id FK
        uuid approver_id FK
        varchar decision "approved|rejected|revision_requested"
        text comments
        timestamptz decided_at
    }

    WORKFLOW_HISTORIES {
        uuid id PK
        uuid workflow_instance_id FK
        uuid from_step_id FK
        uuid to_step_id FK
        varchar action
        uuid action_by FK
        jsonb metadata
        timestamptz action_at
    }

