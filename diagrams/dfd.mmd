        E5["👤 Staff Klinik / Unit Kerja"]
        E6["🔐 Active Directory<br/>Pemprov DKI Jakarta"]
        E7["📦 Supabase / S3<br/>Object Storage"]
    end

    subgraph SYS["Process 0 — SIMMAK PPKP<br/>Sistem Informasi Manajemen Mutu,<br/>Audit Internal dan Akreditasi"]
        direction TB
        P0["0<br/>SIMMAK PPKP<br/>Integrated Quality Platform"]
    end

    E1 -->|"KPI, Readiness Report,<br/>Executive Dashboard"| P0
    P0 -->|"Accreditation Readiness,<br/>Risk Heatmap, Clinic Ranking"| E1

    E2 -->|"Approval Dokumen,<br/>Audit Schedule, CAPA Assignment"| P0
    P0 -->|"Clinic Dashboard,<br/>Open Findings, Expired Docs"| E2

    E3 -->|"Document Draft/Review,<br/>Quality Program, Indicators"| P0
    P0 -->|"Workflow Tasks, CAPA Status,<br/>Quality Monitoring Alerts"| E3

    E4 -->|"Audit Program, Checklist,<br/>Findings, Audit Report"| P0
    P0 -->|"Audit Schedule, Finding Register,<br/>CAPA Trigger"| E4

    E5 -->|"Self Assessment Input,<br/>Evidence Upload, Risk Input"| P0
    P0 -->|"Notifications, Document Access,<br/>Task Assignments"| E5

    E6 -->|"LDAP Authentication<br/>User Credentials"| P0
    P0 -->|"User Sync / SSO Token<br/>Validation Request"| E6

    P0 <-->|"Document Files,<br/>Evidence Attachments"| E7

    classDef external fill:#E3F2FD,stroke:#1565C0,stroke-width:2px,color:#0D47A1
    classDef system fill:#E8F5E9,stroke:#2E7D32,stroke-width:3px,color:#1B5E20
